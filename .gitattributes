# Keep course files byte-for-byte, including their original encoding and line endings.
projects/**/course/** -text

# Normalize repository-authored documentation.
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
*.svg text eol=lf
projects/**/practice/**/*.c text eol=lf
projects/**/practice/**/*.h text eol=lf
projects/**/tests/**/*.c text eol=lf
